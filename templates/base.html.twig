<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Shopware App{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { font-family: Arial, sans-serif; margin: 2em; background: #f8f8f8; }
        h1 { color: #333; }
        form { margin-bottom: 2em; }
        ul { background: #fff; padding: 1em; border-radius: 5px; box-shadow: 0 2px 4px #ccc; }
        .error { color: red; }
    </style>
</head>
<body>
    {% block body %}{% endblock %}
</body>
</html>

